<Window x:Class="IceCreamShop.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ice Cream Shop - Login" Width="350" Height="320"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Email" />
        <TextBox x:Name="EmailBox" Margin="0,4,0,12" />

        <TextBlock Text="Password" />
        <PasswordBox x:Name="PasswordInput" Margin="0,4,0,12" />

        <Button x:Name="LoginButton" Content="Login" Padding="8,4"
                Click="LoginButton_Click" />

        <TextBlock x:Name="ErrorText" Foreground="Red"
                   TextWrapping="Wrap" Margin="0,12,0,0" />
    </StackPanel>
</Window>
