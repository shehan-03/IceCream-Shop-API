<Window x:Class="IceCreamShop.Desktop.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer" Width="380" Height="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox" Margin="0,4,0,10" />

        <TextBlock Text="Phone" />
        <TextBox x:Name="PhoneBox" Margin="0,4,0,10" />

        <TextBlock Text="Email (optional)" />
        <TextBox x:Name="EmailBox" Margin="0,4,0,10" />

        <TextBlock Text="Address (optional)" />
        <TextBox x:Name="AddressBox" Margin="0,4,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Padding="12,4" Click="SaveButton_Click" />
            <Button Content="Cancel" Padding="12,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
</Window>