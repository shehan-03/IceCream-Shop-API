<Window x:Class="IceCreamShop.Desktop.ItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Item" Width="380" Height="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <StackPanel Margin="20">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox" Margin="0,4,0,10" />

        <TextBlock Text="Category" />
        <ComboBox x:Name="CategoryBox" DisplayMemberPath="Name" SelectedValuePath="Id"
                  Margin="0,4,0,10" />

        <TextBlock Text="Description" />
        <TextBox x:Name="DescriptionBox" Margin="0,4,0,10" />

        <TextBlock Text="Price" />
        <TextBox x:Name="PriceBox" Margin="0,4,0,10" />

        <TextBlock Text="Quantity" />
        <TextBox x:Name="QuantityBox" Margin="0,4,0,10" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Padding="12,4" Click="SaveButton_Click" />
            <Button Content="Cancel" Padding="12,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
</Window>