{
  "info": {
    "name": "Ice Cream Shop API",
    "description": "Auth, inventory items and customers with role-based access.\n\n1. Run one of the **Login** requests (owner / manager / cashier). The token is saved automatically.\n2. Call any other request. Switch user by running a different Login.\n\nExpected 403s: cashier creating/deleting items, manager or cashier deleting anything.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "itemId",
      "value": "1"
    },
    {
      "key": "customerId",
      "value": "1"
    },
    {
      "key": "categoryId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in as the seeded owner and stores the token in the collection variable `token`. Every other request sends it as a Bearer token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner@icecream.test\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().data.token;",
                  "pm.collectionVariables.set(\"token\", token);",
                  "console.log(\"Logged in as owner; token saved to {{token}}\");"
                ]
              }
            }
          ]
        },
